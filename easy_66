class Solution {
    public int[] plusOne(int[] digits) {
        // Walk from the least significant digit
        for (int i = digits.length - 1; i >= 0; i--) {
            if (digits[i] < 9) {
                digits[i]++;      // no carry needed, done
                return digits;
            }
            digits[i] = 0;        // 9 becomes 0 and carries to the next digit
        }

        // Every digit was 9 (e.g. 999 -> 1000)
        int[] result = new int[digits.length + 1];
        result[0] = 1;
        return result;
    }
}
